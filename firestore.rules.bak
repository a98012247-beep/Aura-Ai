rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /members/{userId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }
    
    match /global_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /usage/{document=**} {
      allow read: if isAdmin() || (request.auth != null && resource.data.email == request.auth.token.email);
      allow write: if true; // Allowed for server (unauthenticated client SDK)
    }
    
    match /platform_api_keys/{document=**} {
      allow read: if isAdmin() || (resource.data.get('backend_secret', '') == 'AWA_VOX_SECRET_123');
      allow write: if isAdmin();
    }
    
    match /earnings/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /feedback/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /voice_clones/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /security_flags/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
