rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'a98012247@gmail.com'
      );
    }

    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /usage/{usageId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
    }

    match /earnings/{earningId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /preview_api_keys/{keyId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /voice_previews/{previewId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
